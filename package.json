{
  "name": "ajaia-docs",
  "version": "1.0.0",
  "private": true,
  "description": "Lightweight collaborative document editor — Ajaia full stack take-home",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "3.29.0",
    "@tiptap/pm": "3.29.0",
    "@tiptap/react": "3.29.0",
    "@tiptap/starter-kit": "3.29.0",
    "better-sqlite3": "13.0.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.27.0",
    "mammoth": "1.12.0",
    "marked": "18.0.7",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.6",
    "turndown": "7.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.1",
    "@types/turndown": "5.0.6",
    "jszip": "3.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
