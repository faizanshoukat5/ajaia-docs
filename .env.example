# Copy to `.env.local` for local development, or set these in your host's
# dashboard for a deployment. Every value below has a safe default in
# development, so `npm run dev` works with no .env file at all.

# ---------------------------------------------------------------------------
# SESSION_SECRET  (required in production, optional in development)
# ---------------------------------------------------------------------------
# HMAC key used to sign session cookies. In development an insecure fixed value
# is used automatically. In production the server refuses to start without this
# — see src/instrumentation.ts.
#
# Generate one with:
#   openssl rand -base64 32
#
# Rotating it invalidates every existing session.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# DATABASE_PATH  (optional)
# ---------------------------------------------------------------------------
# Where the SQLite file lives. Defaults to ./data/ajaia.db.
#
# On a container host this must point at a mounted persistent volume, or every
# deploy starts from an empty database:
#   DATABASE_PATH=/data/ajaia.db
DATABASE_PATH=

# ---------------------------------------------------------------------------
# PORT  (optional)
# ---------------------------------------------------------------------------
# Defaults to 3000.
PORT=3000
